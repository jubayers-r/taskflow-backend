# Application
PROJECT_NAME="taskflow-backend"
NODE_ENV="development"
PORT=5000
LOG_LEVEL="info"

# Number of trusted reverse-proxy hops used to resolve the real client IP (0 = none).
TRUST_PROXY=1

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow_db?schema=public"

# Test database (optional). Set this to run the integration suites; leave it
# unset and they skip. When set, it REPLACES DATABASE_URL for the whole process,
# including `bun run dev` — so point it at a throwaway database, never a real
# one. On Neon, use a dedicated branch, not your main database.
# TEST_DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# Production compose credentials (docker-compose.prod.yml)
POSTGRES_USER="taskflow"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="taskflow_db"

# Redis Configuration
# USE_REDIS=true  -> Redis-backed queue (BullMQ), rate limiter store & cache
# USE_REDIS=false -> No Redis connection is made; in-memory queue/cache/rate-limit fallbacks
USE_REDIS=true
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# CORS (comma-separated list of origins)
ALLOWED_ORIGINS="http://localhost:3000, http://localhost:5173"

#JWT
JWT_ACCESS_SECRET="your-secret-here"
JWT_ACCESS_EXPIRES_IN="15m"
SALT_ROUNDS=12

# OTP
# Must be at least 32 characters. Use a long random value, e.g. `openssl rand -hex 32`.
OTP_PEPPER_SECRET="change-me-to-a-random-32+char-secret"

# Auth session / brute-force policy
SESSION_TTL_DAYS=7
SESSION_SHORT_TTL_DAYS=1
SESSION_LONG_TTL_DAYS=30
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Sentry error tracking (optional — leave empty to disable)
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1

# Config encryption (AES-256-GCM, base64-encoded 32-byte key).
# Required in production. Generate with: `openssl rand -base64 32`
CONFIG_ENCRYPTION_KEY=""

# Email
EMAIL_PROVIDER="resend" #defaults to gmail
EMAIL_FROM="auth@yourdomain.com"
RESEND_API_KEY="your-api-key-here"
GMAIL_APP_PASSWORD="your-app-password-here"