# Production environment — copy to .env.production and fill in real secrets.
#
# Used by docker-compose.prod.yml as the env file for the app/migrate containers
# and to interpolate compose-level variable placeholders (POSTGRES_USER, etc.).
#
# Generate strong random values with:
#   openssl rand -hex 32

# --- Application ---
PROJECT_NAME="taskflow-backend"
NODE_ENV="production"
PORT=5000
LOG_LEVEL="info"

# Set to 1 if behind a reverse proxy (Traefik, Nginx, Caddy).
TRUST_PROXY=1

# --- Database ---
POSTGRES_USER="taskflow"
POSTGRES_PASSWORD=""           # required — at least 16 chars
POSTGRES_DB="taskflow_db"

# The app container uses this URL to connect. It points to the compose postgres
# service; do not change unless you are using an external database.
DATABASE_URL="postgresql://taskflow:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public"

# --- Redis ---
REDIS_PASSWORD=""              # required

# --- CORS (comma-separated origins) ---
ALLOWED_ORIGINS="https://app.yourdomain.com"

# --- JWT ---
JWT_ACCESS_SECRET=""           # required — generate with: openssl rand -hex 32
JWT_ACCESS_EXPIRES_IN="15m"
SALT_ROUNDS=12

# --- OTP ---
OTP_PEPPER_SECRET=""           # required — generate with: openssl rand -hex 32

# --- Auth policy ---
SESSION_TTL_DAYS=7
SESSION_SHORT_TTL_DAYS=1
SESSION_LONG_TTL_DAYS=30
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# --- Sentry (optional — leave empty to disable) ---
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Email ---
EMAIL_PROVIDER="resend"
EMAIL_FROM="auth@yourdomain.com"
RESEND_API_KEY=""              # required if using Resend
GMAIL_APP_PASSWORD=""          # required if using Gmail provider
