model Payment {
    id String @id @default(uuid())

    userId String?
    user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

    agencyId String?
    agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

    amountInCents Int
    currency      String @default("USD")

    paymentType PaymentType

    status     PaymentStatus @default(PENDING)
    receiptUrl String?

    stripePaymentIntentId String? @unique // The ID from the provider (e.g., ch_3N1...)
    stripeCustomerId      String?

    // Stripe specific
    stripeCheckoutSessionId String @unique // This should store the Stripe Session ID or PaymentIntent ID

    failureMessage String?
    rawResponse    Json? // Full webhook audit

    statusHistory PaymentHistory[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("payments")
}

model Subscription {
    id     String  @id @default(uuid())
    userId String?
    user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

    tier   SubscriptionTier   @default(FREE)
    status SubscriptionStatus @default(ACTIVE) // "active", "canceled"

    agencyId String
    agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

    stripeSubscriptionId String? @unique
    stripePriceId        String?

    amount       Int? // Store in cents (e.g., 1000 for $10.00)
    planInterval PlanInterval // MONTHLY, QUARTERLY, YEARLY

    currentPeriodEnd  DateTime?
    cancelAtPeriodEnd Boolean   @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([agencyId])
    @@index([status])
    @@map("subscriptions")
}

model PaymentHistory {
    id        String        @id @default(uuid())
    paymentId String
    payment   Payment       @relation(fields: [paymentId], references: [id])
    status    PaymentStatus
    message   String? // e.g., "Customer authenticated via 3DS"
    createdAt DateTime      @default(now())
}

enum PlanInterval {
    MONTHLY
    QUARTERLY
    YEARLY
}

enum SubscriptionTier {
    FREE
    PRO
    BUSINESS
}

enum SubscriptionStatus {
    ACTIVE
    TRIALING
    PAST_DUE
    CANCELED
    UNPAID
    INCOMPLETE
    INCOMPLETE_EXPIRED
    PAUSED
}

enum PaymentStatus {
    UNPAID // Default for COD
    PENDING // Initial state for online
    PROCESSING // Gateway is verifying (important for webhooks)
    REQUIRES_ACTION // For 3D Secure/SCA
    AUTHORIZED // Hold on funds
    PAID // Successful payment
    FAILED // Payment declined
    CANCELED
    REFUNDED // Money sent back
    PARTIALLY_REFUNDED
}

enum PaymentType {
    ONE_TIME
    RECURRING
}
