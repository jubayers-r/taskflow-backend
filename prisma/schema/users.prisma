model User {
    id           String     @id @default(uuid())
    email        String     @unique
    passwordHash String
    firstName    String
    lastName     String
    gender       GenderEnum
    profileImage String?    @default("https://img.icons8.com/?size=256&id=85050&format=png")
    role         UserRole   @default(MEMBER)

    isActive     Boolean @default(true)
    isRestricted Boolean @default(false)

    isAgreeWithTerms Boolean   @default(false)
    termsAgreedAt    DateTime?
    emailVerifiedAt  DateTime?
    otps             OTP[] // Added relation link

    comments     Comment[]
    attachments  Attachment[]
    activityLogs ActivityLog[]
    agency       Agency        @relation(fields: [agencyId], references: [id])
    agencyId     String
    tasks        Task[]

    createdAt       DateTime       @default(now())
    updatedAt       DateTime       @updatedAt
    sentInvitations Invitation[]   @relation("SentInvitations")
    payments        Payment[]
    subscriptions   Subscription[]
    sessions        Session[]

    @@index([agencyId])
    @@map("users")
}

model Session {
    id           String    @id @default(uuid()) // Acts as your stable familyId
    userId       String
    fcmToken     String?   @unique // Optional FCM token linked to this specific device
    userAgent    String?
    ipAddress    String?
    lastActiveAt DateTime  @default(now())
    revokedAt    DateTime? // Revoking the session kills all rotated tokens in it

    user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    refreshTokens RefreshToken[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@map("sessions")
}

model RefreshToken {
    id        String   @id @default(uuid())
    tokenHash String   @unique
    sessionId String // Groups rotated tokens from the same login session/device
    isUsed    Boolean  @default(false)
    expiresAt DateTime

    session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@index([sessionId])
    @@index([expiresAt])
    @@map("refresh_tokens")
}

model OTP {
    id         String     @id @default(uuid())
    identifier String
    codeHash   String
    purpose    OtpPurpose
    channel    OtpChannel

    attempts    Int       @default(0)
    maxAttempts Int       @default(5)
    expiresAt   DateTime
    consumedAt  DateTime? // Track when it was used/invalidated

    ipAddress String?
    userAgent String?

    userId String? // Optional if sending OTP to non-users (like guest signup)
    user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([identifier, consumedAt])
    @@index([identifier, purpose, consumedAt])
    @@index([expiresAt])
    @@map("otps")
}

enum OtpChannel {
    EMAIL
    SMS
}

enum OtpPurpose {
    VERIFY_EMAIL
    PASSWORD_RESET
    LOGIN
}

enum GenderEnum {
    MALE
    FEMALE
    OTHER
}

enum TokenTypeEnum {
    ACCESS
    REFRESH
    PASSWORD_RESET
}

enum UserRole {
    OWNER
    MANAGER
    MEMBER
}
